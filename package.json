{
  "name": "svn-compass",
  "displayName": "SVN Compass",
  "description": "在 VS Code 中使用 TortoiseSVN 更新、提交、回退、Diff、加入版本管理，并在资源管理器与源代码管理侧栏展示 SVN 更改。",
  "version": "0.2.7",
  "publisher": "leager",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Leager-zju/TortoiseSVN-in-VSCode.git"
  },
  "homepage": "https://github.com/Leager-zju/TortoiseSVN-in-VSCode#readme",
  "bugs": {
    "url": "https://github.com/Leager-zju/TortoiseSVN-in-VSCode/issues"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "该扩展会调用本机 SVN 和 TortoiseSVN 可执行文件，仅在受信任工作区中启用。"
    }
  },
  "categories": [
    "SCM Providers"
  ],
  "keywords": [
    "svn",
    "subversion",
    "tortoisesvn",
    "scm"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "svn.update",
        "title": "更新",
        "category": "SVN",
        "icon": "$(sync)"
      },
      {
        "command": "svn.commit",
        "title": "提交",
        "category": "SVN",
        "icon": "$(check)"
      },
      {
        "command": "svn.log",
        "title": "日志",
        "category": "SVN",
        "icon": "$(history)"
      },
      {
        "command": "svn.selectionHistory",
        "title": "查看选中内容 SVN 历史",
        "category": "SVN",
        "icon": "$(git-commit)"
      },
      {
        "command": "svn.blameLine",
        "title": "Blame",
        "category": "SVN",
        "icon": "$(git-commit)"
      },
      {
        "command": "svn.revert",
        "title": "回退",
        "category": "SVN",
        "icon": "$(discard)"
      },
      {
        "command": "svn.revertChange",
        "title": "回退此差异",
        "category": "SVN",
        "icon": "$(discard)"
      },
      {
        "command": "svn.resolve",
        "title": "标记冲突已解决",
        "category": "SVN",
        "icon": "$(check)"
      },
      {
        "command": "svn.openConflict",
        "title": "处理冲突",
        "category": "SVN",
        "icon": "$(merge)"
      },
      {
        "command": "svn.createPatch",
        "title": "创建 Patch",
        "category": "SVN",
        "icon": "$(file-add)"
      },
      {
        "command": "svn.createPatchGroup",
        "title": "创建 Patch",
        "category": "SVN",
        "icon": "$(file-add)"
      },
      {
        "command": "svn.openPatch",
        "title": "打开 Patch",
        "category": "SVN",
        "icon": "$(file-code)"
      },
      {
        "command": "svn.applyPatch",
        "title": "Apply",
        "category": "SVN",
        "icon": "$(play)"
      },
      {
        "command": "svn.removePatch",
        "title": "Remove",
        "category": "SVN",
        "icon": "$(trash)"
      },
      {
        "command": "svn.openFile",
        "title": "打开文件",
        "category": "SVN",
        "icon": "$(go-to-file)"
      },
      {
        "command": "svn.diff",
        "title": "Diff",
        "category": "SVN",
        "icon": "$(diff)"
      },
      {
        "command": "svn.add",
        "title": "加入版本管理",
        "category": "SVN",
        "icon": "$(add)"
      },
      {
        "command": "svn.refresh",
        "title": "刷新 SVN 状态",
        "category": "SVN",
        "icon": "$(refresh)"
      },
      {
        "command": "svn.moveToNewGroup",
        "title": "新建分组",
        "category": "SVN",
        "icon": "$(add)"
      },
      {
        "command": "svn.moveToExistingGroup",
        "title": "选择已有分组…",
        "category": "SVN",
        "icon": "$(list-selection)"
      },
      {
        "command": "svn.renameGroup",
        "title": "重命名分组",
        "category": "SVN",
        "icon": "$(edit)"
      },
      {
        "command": "svn.deleteGroup",
        "title": "删除分组",
        "category": "SVN",
        "icon": "$(trash)"
      },
      {
        "command": "svn.commitGroup",
        "title": "提交当前分组",
        "category": "SVN",
        "icon": "$(check)"
      },
      {
        "command": "svn.revertGroup",
        "title": "回退当前分组",
        "category": "SVN",
        "icon": "$(discard)"
      },
      {
        "command": "svn.createCodeReviewGroup",
        "title": "创建 Code Review",
        "category": "SVN",
        "icon": "$(request-changes)"
      },
      {
        "command": "svn.createCodeReview",
        "title": "创建 Code Review",
        "category": "SVN",
        "icon": "$(request-changes)"
      }
    ],
    "submenus": [
      {
        "id": "svn.moveToGroup",
        "label": "选择分组"
      },
      {
        "id": "svn.operations",
        "label": "SVN操作"
      }
    ],
    "views": {
      "scm": [
        {
          "id": "svn.patchView",
          "name": "Patch",
          "type": "tree",
          "icon": "$(diff)",
          "visibility": "visible"
        },
        {
          "id": "svn.conflictView",
          "name": "冲突文件列表",
          "type": "tree",
          "icon": "$(warning)",
          "visibility": "visible"
        }
      ]
    },
    "menus": {
      "explorer/context": [
        {
          "submenu": "svn.operations",
          "when": "resourceScheme == file",
          "group": "1_svn@1"
        }
      ],
      "editor/context": [
        {
          "command": "svn.selectionHistory",
          "when": "resourceScheme == file && editorHasSelection",
          "group": "0_svn@1"
        },
        {
          "submenu": "svn.operations",
          "when": "resourceScheme == file",
          "group": "0_svn@2"
        }
      ],
      "editor/lineNumber/context": [
        {
          "command": "svn.blameLine",
          "when": "resourceScheme == file",
          "group": "blame@1"
        }
      ],
      "scm/title": [
        {
          "command": "svn.refresh",
          "when": "scmProvider == svn",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "svn.openFile",
          "when": "isInDiffEditor && resourceScheme == svn-working",
          "group": "navigation"
        }
      ],
      "scm/change/title": [
        {
          "command": "svn.revertChange",
          "when": "originalResourceScheme == svn-base"
        }
      ],
      "commandPalette": [
        {
          "command": "svn.revertChange",
          "when": "false"
        },
        {
          "command": "svn.createPatch",
          "when": "false"
        },
        {
          "command": "svn.openPatch",
          "when": "false"
        },
        {
          "command": "svn.applyPatch",
          "when": "false"
        },
        {
          "command": "svn.removePatch",
          "when": "false"
        },
        {
          "command": "svn.createPatchGroup",
          "when": "false"
        },
        {
          "command": "svn.moveToNewGroup",
          "when": "false"
        },
        {
          "command": "svn.moveToExistingGroup",
          "when": "false"
        },
        {
          "command": "svn.renameGroup",
          "when": "false"
        },
        {
          "command": "svn.deleteGroup",
          "when": "false"
        },
        {
          "command": "svn.commitGroup",
          "when": "false"
        },
        {
          "command": "svn.revertGroup",
          "when": "false"
        },
        {
          "command": "svn.createCodeReviewGroup",
          "when": "false"
        },
        {
          "command": "svn.createCodeReview",
          "when": "false"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "svn.openFile",
          "when": "scmProvider == svn && (scmResourceState == svn.changed || scmResourceState == svn.conflicted)",
          "group": "inline@1"
        },
        {
          "command": "svn.diff",
          "when": "scmProvider == svn && (scmResourceState == svn.changed || scmResourceState == svn.conflicted)",
          "group": "inline@2"
        },
        {
          "command": "svn.revert",
          "when": "scmProvider == svn && (scmResourceState == svn.changed || scmResourceState == svn.conflicted)",
          "group": "inline@3"
        },
        {
          "submenu": "svn.moveToGroup",
          "when": "scmProvider == svn && (scmResourceState == svn.changed || scmResourceState == svn.conflicted)",
          "group": "1_group@1"
        },
        {
          "submenu": "svn.operations",
          "when": "scmProvider == svn",
          "group": "2_svn@1"
        }
      ],
      "view/item/context": [
        {
          "command": "svn.applyPatch",
          "when": "view == svn.patchView && viewItem == svn.patch",
          "group": "navigation@1"
        },
        {
          "command": "svn.removePatch",
          "when": "view == svn.patchView && viewItem == svn.patch",
          "group": "navigation@2"
        },
        {
          "command": "svn.resolve",
          "when": "view == svn.conflictView && viewItem == svn.conflict",
          "group": "navigation@1"
        }
      ],
      "svn.moveToGroup": [
        {
          "command": "svn.moveToNewGroup",
          "when": "scmProvider == svn",
          "group": "1_create@1"
        },
        {
          "command": "svn.moveToExistingGroup",
          "when": "scmProvider == svn",
          "group": "2_groups@1"
        }
      ],
      "svn.operations": [
        {
          "command": "svn.update",
          "when": "isWindows",
          "group": "1_svn@1"
        },
        {
          "command": "svn.commit",
          "when": "isWindows",
          "group": "1_svn@2"
        },
        {
          "command": "svn.revert",
          "when": "isWindows && (resourcePath in svn.changedResourcePaths || scmResourceState == svn.changed || scmResourceState == svn.conflicted)",
          "group": "1_svn@3"
        },
        {
          "command": "svn.log",
          "group": "1_svn@4"
        },
        {
          "command": "svn.diff",
          "when": "resourcePath in svn.changedResourcePaths || scmResourceState == svn.changed || scmResourceState == svn.conflicted",
          "group": "1_svn@5"
        },
        {
          "command": "svn.createPatch",
          "when": "resourcePath in svn.changedResourcePaths || scmResourceState == svn.changed || scmResourceState == svn.conflicted",
          "group": "1_svn@6"
        },
        {
          "command": "svn.createCodeReview",
          "when": "isWindows && (resourcePath in svn.changedResourcePaths || scmResourceState == svn.changed || scmResourceState == svn.conflicted)",
          "group": "1_svn@7"
        },
        {
          "command": "svn.resolve",
          "when": "resourcePath in svn.conflictedResourcePaths || scmResourceState == svn.conflicted",
          "group": "1_svn@8"
        },
        {
          "command": "svn.add",
          "when": "isWindows && resourcePath in svn.unversionedResourcePaths",
          "group": "2_add@1"
        }
      ],
      "scm/resourceGroup/context": [
        {
          "command": "svn.commitGroup",
          "when": "scmProvider == svn && isWindows",
          "group": "1_actions@1"
        },
        {
          "command": "svn.revertGroup",
          "when": "scmProvider == svn && isWindows",
          "group": "1_actions@2"
        },
        {
          "command": "svn.createPatchGroup",
          "when": "scmProvider == svn",
          "group": "1_actions@3"
        },
        {
          "command": "svn.createCodeReviewGroup",
          "when": "scmProvider == svn && isWindows",
          "group": "1_actions@4"
        },
        {
          "command": "svn.renameGroup",
          "when": "scmProvider == svn && scmResourceGroup =~ /^custom-/",
          "group": "2_manage@1"
        },
        {
          "command": "svn.deleteGroup",
          "when": "scmProvider == svn && scmResourceGroup =~ /^custom-/",
          "group": "2_manage@2"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "svn.conflictView",
        "contents": "当前工作副本没有 SVN 冲突文件。"
      }
    ],
    "configuration": {
      "title": "SVN",
      "properties": {
        "svn.path": {
          "type": "string",
          "default": "svn.exe",
          "description": "svn.exe 路径。默认从 PATH 查找。"
        },
        "svn.tortoiseProc.path": {
          "type": "string",
          "default": "TortoiseProc.exe",
          "description": "TortoiseProc.exe 路径。默认从 PATH 查找。"
        },
        "svn.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "自动刷新资源管理器和源代码管理侧栏中的 SVN 状态。"
        },
        "svn.refreshInterval": {
          "type": "number",
          "default": 3000,
          "minimum": 1000,
          "description": "自动刷新间隔（毫秒）。"
        }
      }
    }
  },
  "scripts": {
    "compile": "npm run typecheck && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "npm run compile && vsce package"
  },
  "dependencies": {
    "fast-xml-parser": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "1.96.0",
    "@vscode/vsce": "^3.7.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}