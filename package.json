{
  "name": "svn-compass",
  "displayName": "SVN Compass",
  "description": "在 VS Code 中使用 TortoiseSVN 更新、提交、回退、Diff、加入版本管理，并在资源管理器与源代码管理侧栏展示 SVN 更改。",
  "version": "0.1.9",
  "publisher": "leager",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Leager-zju/TortoiseSVN-in-VSCode.git"
  },
  "homepage": "https://github.com/Leager-zju/TortoiseSVN-in-VSCode#readme",
  "bugs": {
    "url": "https://github.com/Leager-zju/TortoiseSVN-in-VSCode/issues"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "keywords": [
    "svn",
    "subversion",
    "tortoisesvn",
    "scm"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "svn.update",
        "title": "SVN 更新",
        "category": "SVN",
        "icon": "$(sync)"
      },
      {
        "command": "svn.commit",
        "title": "SVN 提交",
        "category": "SVN",
        "icon": "$(check)"
      },
      {
        "command": "svn.log",
        "title": "SVN 日志",
        "category": "SVN",
        "icon": "$(history)"
      },
      {
        "command": "svn.selectionHistory",
        "title": "查看选中内容 SVN 历史",
        "category": "SVN",
        "icon": "$(git-commit)"
      },
      {
        "command": "svn.revert",
        "title": "SVN 回退",
        "category": "SVN",
        "icon": "$(discard)"
      },
      {
        "command": "svn.revertChange",
        "title": "回退此差异",
        "category": "SVN",
        "icon": "$(discard)"
      },
      {
        "command": "svn.openFile",
        "title": "打开文件",
        "category": "SVN",
        "icon": "$(go-to-file)"
      },
      {
        "command": "svn.diff",
        "title": "SVN Diff",
        "category": "SVN",
        "icon": "$(diff)"
      },
      {
        "command": "svn.add",
        "title": "SVN 加入版本管理",
        "category": "SVN",
        "icon": "$(add)"
      },
      {
        "command": "svn.refresh",
        "title": "刷新 SVN 状态",
        "category": "SVN",
        "icon": "$(refresh)"
      },
      {
        "command": "svn.moveToNewGroup",
        "title": "新建分组",
        "category": "SVN",
        "icon": "$(add)"
      },
      {
        "command": "svn.moveToExistingGroup",
        "title": "选择已有分组…",
        "category": "SVN",
        "icon": "$(list-selection)"
      },
      {
        "command": "svn.renameGroup",
        "title": "重命名分组",
        "category": "SVN",
        "icon": "$(edit)"
      },
      {
        "command": "svn.deleteGroup",
        "title": "删除分组",
        "category": "SVN",
        "icon": "$(trash)"
      },
      {
        "command": "svn.commitGroup",
        "title": "提交当前分组",
        "category": "SVN",
        "icon": "$(check)"
      },
      {
        "command": "svn.revertGroup",
        "title": "回退当前分组",
        "category": "SVN",
        "icon": "$(discard)"
      },
      {
        "command": "svn.createCodeReviewGroup",
        "title": "创建 Code Review",
        "category": "SVN",
        "icon": "$(request-changes)"
      }
    ],
    "submenus": [
      {
        "id": "svn.moveToGroup",
        "label": "移动到分组"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "svn.update",
          "when": "resourceScheme == file && isWindows",
          "group": "svn@1"
        },
        {
          "command": "svn.commit",
          "when": "resourceScheme == file && isWindows",
          "group": "svn@2"
        },
        {
          "command": "svn.log",
          "when": "resourceScheme == file",
          "group": "svn@3"
        },
        {
          "command": "svn.revert",
          "when": "resourceScheme == file && isWindows && resourcePath in svn.changedResourcePaths",
          "group": "svn@4"
        },
        {
          "command": "svn.diff",
          "when": "resourceScheme == file && resourcePath in svn.changedResourcePaths",
          "group": "svn@5"
        },
        {
          "command": "svn.add",
          "when": "resourceScheme == file && isWindows && resourcePath in svn.unversionedResourcePaths",
          "group": "svn@6"
        }
      ],
      "editor/context": [
        {
          "command": "svn.update",
          "when": "resourceScheme == file && isWindows",
          "group": "svn@1"
        },
        {
          "command": "svn.commit",
          "when": "resourceScheme == file && isWindows",
          "group": "svn@2"
        },
        {
          "command": "svn.log",
          "when": "resourceScheme == file",
          "group": "svn@3"
        },
        {
          "command": "svn.selectionHistory",
          "when": "resourceScheme == file && editorHasSelection",
          "group": "svn@3.5"
        },
        {
          "command": "svn.revert",
          "when": "resourceScheme == file && isWindows && resourcePath in svn.changedResourcePaths",
          "group": "svn@4"
        },
        {
          "command": "svn.diff",
          "when": "resourceScheme == file && resourcePath in svn.changedResourcePaths",
          "group": "svn@5"
        },
        {
          "command": "svn.add",
          "when": "resourceScheme == file && isWindows && resourcePath in svn.unversionedResourcePaths",
          "group": "svn@6"
        }
      ],
      "scm/title": [
        {
          "command": "svn.refresh",
          "when": "scmProvider == svn",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "svn.openFile",
          "when": "isInDiffEditor && resourceScheme == svn-working",
          "group": "navigation"
        }
      ],
      "scm/change/title": [
        {
          "command": "svn.revertChange",
          "when": "originalResource =~ /^svn-base\\:/"
        }
      ],
      "commandPalette": [
        {
          "command": "svn.revertChange",
          "when": "false"
        },
        {
          "command": "svn.moveToNewGroup",
          "when": "false"
        },
        {
          "command": "svn.moveToExistingGroup",
          "when": "false"
        },
        {
          "command": "svn.renameGroup",
          "when": "false"
        },
        {
          "command": "svn.deleteGroup",
          "when": "false"
        },
        {
          "command": "svn.commitGroup",
          "when": "false"
        },
        {
          "command": "svn.revertGroup",
          "when": "false"
        },
        {
          "command": "svn.createCodeReviewGroup",
          "when": "false"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "svn.openFile",
          "when": "scmProvider == svn && scmResourceState == svn.changed",
          "group": "inline@1"
        },
        {
          "command": "svn.diff",
          "when": "scmProvider == svn && scmResourceState == svn.changed",
          "group": "inline@2"
        },
        {
          "command": "svn.revert",
          "when": "scmProvider == svn && scmResourceState == svn.changed && isWindows",
          "group": "inline@3"
        },
        {
          "submenu": "svn.moveToGroup",
          "when": "scmProvider == svn && scmResourceState == svn.changed",
          "group": "navigation@1"
        },
        {
          "command": "svn.commit",
          "when": "scmProvider == svn && isWindows",
          "group": "navigation@2"
        },
        {
          "command": "svn.log",
          "when": "scmProvider == svn",
          "group": "navigation@3"
        }
      ],
      "svn.moveToGroup": [
        {
          "command": "svn.moveToNewGroup",
          "when": "scmProvider == svn",
          "group": "1_create@1"
        },
        {
          "command": "svn.moveToExistingGroup",
          "when": "scmProvider == svn",
          "group": "2_groups@1"
        }
      ],
      "scm/resourceGroup/context": [
        {
          "command": "svn.commitGroup",
          "when": "scmProvider == svn && isWindows",
          "group": "1_actions@1"
        },
        {
          "command": "svn.revertGroup",
          "when": "scmProvider == svn && isWindows",
          "group": "1_actions@2"
        },
        {
          "command": "svn.createCodeReviewGroup",
          "when": "scmProvider == svn && isWindows",
          "group": "1_actions@3"
        },
        {
          "command": "svn.renameGroup",
          "when": "scmProvider == svn && scmResourceGroup =~ /^custom-/",
          "group": "2_manage@1"
        },
        {
          "command": "svn.deleteGroup",
          "when": "scmProvider == svn && scmResourceGroup =~ /^custom-/",
          "group": "2_manage@2"
        }
      ]
    },
    "configuration": {
      "title": "SVN",
      "properties": {
        "svn.path": {
          "type": "string",
          "default": "svn.exe",
          "description": "svn.exe 路径。默认从 PATH 查找。"
        },
        "svn.tortoiseProc.path": {
          "type": "string",
          "default": "TortoiseProc.exe",
          "description": "TortoiseProc.exe 路径。默认从 PATH 查找。"
        },
        "svn.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "自动刷新资源管理器和源代码管理侧栏中的 SVN 状态。"
        },
        "svn.refreshInterval": {
          "type": "number",
          "default": 3000,
          "minimum": 1000,
          "description": "自动刷新间隔（毫秒）。"
        }
      }
    }
  },
  "scripts": {
    "compile": "npm run typecheck && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "npm run compile && vsce package"
  },
  "dependencies": {
    "fast-xml-parser": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "1.96.0",
    "@vscode/vsce": "^3.7.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}